# Application
NODE_ENV=development
APP_ENV=DEV
APP_NAME=FODIP Digital 2030
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/fodip
DATABASE_SSL=false

# Authentication
JWT_ISSUER=fodip-digital-2030
JWT_AUDIENCE=fodip-web
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_SECRET=CHANGE_ME

# S3-compatible document storage (MinIO in Docker)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=fodip-documents
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME

# Cache / async
REDIS_URL=redis://localhost:6379
SERVICE_BUS_CONNECTION_STRING=CHANGE_ME

# Data Platform
SNOWFLAKE_ACCOUNT=CHANGE_ME
SNOWFLAKE_USER=CHANGE_ME
SNOWFLAKE_ROLE=CHANGE_ME
SNOWFLAKE_WAREHOUSE=CHANGE_ME
SNOWFLAKE_DATABASE=CHANGE_ME
SNOWFLAKE_SCHEMA=CHANGE_ME

# Observability
OTEL_SERVICE_NAME=fodip-api
# Optional. Tracing (HTTP, Express routes, PostgreSQL queries) only starts when this is set to a
# reachable OTLP/HTTP collector (Grafana Tempo, Jaeger, Datadog agent, ...); left unset here on
# purpose so the local Docker demo stays inert. See docs/06-BACKEND-AUTH-RBAC.md.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# IMPORTANT: this file contains placeholders only. Never commit real secrets.

# Application
NODE_ENV=development
APP_ENV=DEV
APP_NAME=FODIP Digital 2030
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/fodip
# Direct connection used by migrations/bootstrap on providers such as Neon. The API keeps using
# the pooled DATABASE_URL above. It may equal DATABASE_URL on a conventional PostgreSQL server.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST:5432/fodip
DATABASE_SSL=false

# One-time first administrator bootstrap. Set all required values for the first hosted deploy,
# then remove them immediately after success. The account is created with mandatory MFA.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.gov.gn
# BOOTSTRAP_ADMIN_NOM=KABA
# BOOTSTRAP_ADMIN_PRENOM=Cheickna
# BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_AND_UNIQUE

# Authentication
JWT_ISSUER=fodip-digital-2030
JWT_AUDIENCE=fodip-web
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_SECRET=CHANGE_ME
# Optional, axis E4 (key rotation, docs/14-ROADMAP-SAAS-PREMIUM.md). To rotate JWT_SECRET without
# invalidating tokens already handed out: set JWT_SECRET_PREVIOUS to JWT_SECRET's OLD value, then
# set JWT_SECRET to the new one. Both are accepted for verification during the rotation window;
# only JWT_SECRET signs new tokens. Remove JWT_SECRET_PREVIOUS once JWT_ACCESS_TTL has passed
# since the rotation (this platform has no refresh-token flow, so that's the longest a token
# issued under the old secret can still be presented). Scoped to JWT signing only - see
# apps/api/src/security-policy.js's resolveJwtSigningKeys comment for why this does not extend to
# the PII/MFA/OIDC secrets derived from JWT_SECRET.
# JWT_SECRET_PREVIOUS=

# S3-compatible document storage (MinIO in Docker)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=fodip-documents
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME

# Cache / async
REDIS_URL=redis://localhost:6379
SERVICE_BUS_CONNECTION_STRING=CHANGE_ME

# Data Platform
SNOWFLAKE_ACCOUNT=CHANGE_ME
SNOWFLAKE_USER=CHANGE_ME
SNOWFLAKE_ROLE=CHANGE_ME
SNOWFLAKE_WAREHOUSE=CHANGE_ME
SNOWFLAKE_DATABASE=CHANGE_ME
SNOWFLAKE_SCHEMA=CHANGE_ME

# Observability
OTEL_SERVICE_NAME=fodip-api
# Optional. Tracing (HTTP, Express routes, PostgreSQL queries) only starts when this is set to a
# reachable OTLP/HTTP collector (Grafana Tempo, Jaeger, Datadog agent, ...); left unset here on
# purpose so the local Docker demo stays inert. See docs/06-BACKEND-AUTH-RBAC.md.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Institutional SSO (OpenID Connect, e.g. Keycloak) - optional, axis B4.
# All four API_* variables below must be set together for the API to enable the /auth/oidc/*
# routes; left unset here so the local Docker demo keeps using email/password + TOTP only.
# OIDC is authentication-only: it never creates accounts or grants roles by itself, and the
# platform's own MFA requirement (when set on an account) still applies after an OIDC sign-in.
# See docs/06-BACKEND-AUTH-RBAC.md and docs/14-ROADMAP-SAAS-PREMIUM.md (axis B4).
# OIDC_ISSUER_URL=https://idp.example.gov.gn/realms/fodip
# OIDC_CLIENT_ID=fodip-web
# OIDC_CLIENT_SECRET=CHANGE_ME
# OIDC_REDIRECT_URI=http://localhost:4000/api/v1/auth/oidc/callback
# API_BASE_URL as seen by the browser (not the Docker-internal service name) - required by the
# web app to redirect the browser to the API's OIDC login endpoint. Only needed when OIDC is
# enabled; safe to leave unset otherwise.
# API_PUBLIC_URL=http://localhost:4000

# Antivirus document scanning (ClamAV) - optional, axis E6. Left unset here so the local demo and
# the test suite (which run their own in-process fakes) never require a running ClamAV daemon.
# Set CLAMAV_HOST to enable real scanning of document uploads before they are persisted; a scan
# failure once this is set fails the upload closed (503), it never bypasses the scan silently.
# With Docker Compose, run `docker compose --profile antivirus up` and set CLAMAV_HOST=clamav.
# See apps/api/src/documents/clamav.service.ts and docs/14-ROADMAP-SAAS-PREMIUM.md (axis E6).
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310

# IMPORTANT: this file contains placeholders only. Never commit real secrets.

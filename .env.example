# Application
NODE_ENV=development
APP_ENV=DEV
APP_NAME=FODIP Digital 2030
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/fodip

# Authentication
JWT_ISSUER=fodip-digital-2030
JWT_AUDIENCE=fodip-web
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_SECRET=CHANGE_ME

# Storage
AZURE_STORAGE_ACCOUNT=CHANGE_ME
AZURE_STORAGE_CONTAINER=fodip-documents
# Local Azurite only; production uses AZURE_STORAGE_ACCOUNT + Managed Identity.
# AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# Cache / async
REDIS_URL=redis://localhost:6379
SERVICE_BUS_CONNECTION_STRING=CHANGE_ME

# Data Platform
SNOWFLAKE_ACCOUNT=CHANGE_ME
SNOWFLAKE_USER=CHANGE_ME
SNOWFLAKE_ROLE=CHANGE_ME
SNOWFLAKE_WAREHOUSE=CHANGE_ME
SNOWFLAKE_DATABASE=CHANGE_ME
SNOWFLAKE_SCHEMA=CHANGE_ME

# Observability
OTEL_SERVICE_NAME=fodip-api

# IMPORTANT: this file contains placeholders only. Never commit real secrets.
